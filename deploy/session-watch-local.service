[Unit]
Description=Session Watch read-only local 3x-ui collector
After=local-fs.target network.target

[Service]
Type=simple
User=root
Group=session-watch
WorkingDirectory=/opt/xray-session-notify
ExecStart=/usr/bin/python3 /opt/xray-session-notify/deploy/local_collector.py
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/x-ui /usr/local/x-ui /opt/xray-session-notify
ReadWritePaths=/var/lib/session-watch-local
InaccessiblePaths=/etc/shadow /etc/gshadow /etc/ssh /var/lib/session-watch
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=96M

[Install]
WantedBy=multi-user.target
